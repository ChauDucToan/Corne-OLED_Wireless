#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 39 40 41>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <185>;
            hold-trigger-on-release;
        };

        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <230>;
            quick-tap-ms = <150>;
            require-prior-idle-ms = <185>;
            flavor = "tap-preferred";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38>;
            hold-trigger-on-release;
        };

        my_lt: my_lt {
            compatible = "zmk,behavior-hold-tap";
            label = "MY_LT";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <120>;
            flavor = "balanced";
            hold-trigger-on-release;
        };

        m_tap_hold: m_tap_hold {
            compatible = "zmk,behavior-hold-tap";
            label = "M_TAP_HOLD";
            bindings = <&msc>, <&mkp>;

            #binding-cells = <2>;
            tapping-term-ms = <160>;
            quick-tap-ms = <140>;
            require-prior-idle-ms = <80>;
            flavor = "tap-preferred";
            hold-trigger-on-release;
        };
    };

    combos {
        compatible = "zmk,combos";

        Exclamation {
            bindings = <&kp EXCL>;
            key-positions = <1 13>;
            layers = <0>;
            timeout-ms = <50>;
        };

        ACir {
            bindings = <&kp AT_SIGN>;
            key-positions = <2 14>;
            timeout-ms = <50>;
            layers = <0>;
        };

        Pound {
            bindings = <&kp POUND>;
            key-positions = <3 15>;
            timeout-ms = <50>;
            layers = <0>;
        };

        Dollar {
            bindings = <&kp DOLLAR>;
            key-positions = <4 16>;
            timeout-ms = <50>;
            layers = <0>;
        };

        Percentage {
            bindings = <&kp PERCENT>;
            key-positions = <5 17>;
            timeout-ms = <50>;
            layers = <0>;
        };

        Caret {
            bindings = <&kp CARET>;
            key-positions = <6 18>;
            timeout-ms = <50>;
            layers = <0>;
        };

        Ampersand {
            bindings = <&kp AMPERSAND>;
            key-positions = <7 19>;
            timeout-ms = <50>;
            layers = <0>;
        };

        Star {
            bindings = <&kp KP_ASTERISK>;
            key-positions = <8 20>;
            timeout-ms = <50>;
            layers = <0>;
        };

        LParent {
            bindings = <&kp LEFT_PARENTHESIS>;
            key-positions = <21 9>;
            timeout-ms = <50>;
            layers = <0>;
        };

        RParent {
            bindings = <&kp RIGHT_PARENTHESIS>;
            key-positions = <22 10>;
            timeout-ms = <50>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            bindings = <
&kp CAPS  &kp Q            &kp W            &kp E         &kp R              &kp T             &kp Y         &kp U               &kp I         &kp O        &kp P           &to 5
&kp HOME  &hml LEFT_GUI A  &hml LEFT_ALT S  &hml LCTRL D  &hml LEFT_SHIFT F  &kp G             &kp H         &hmr RIGHT_SHIFT J  &hmr RCTRL K  &hmr RALT L  &hmr RGUI SEMI  &kp PG_UP
&kp END   &kp Z            &kp X            &kp C         &kp V              &kp B             &kp N         &kp M               &kp COMMA     &kp DOT      &kp FSLH        &kp PG_DN
                                            &kp TAB       &my_lt 3 ESC       &my_lt 2 SPACE    &my_lt 1 RET  &my_lt 4 BACKSPACE  &kp DELETE
            >;
        };

        navigation_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&trans  &none           &kp K_CUT       &kp K_PASTE   &kp K_COPY       &none                         &kp INSERT      &kp K_UNDO     &kp K_REDO    &none      &none  &trans
&trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP  &mmv MOVE_RIGHT  &m_tap_hold SCRL_UP MB1       &kp LEFT_ARROW  &kp DOWN       &kp UP_ARROW  &kp RIGHT  &none  &trans
&trans  &none           &none           &none         &none            &m_tap_hold SCRL_DOWN RCLK    &none           &none          &none         &none      &none  &trans
                                        &kp TAB       &kp ESCAPE       &kp SPACE                     &trans          &kp BACKSPACE  &kp DELETE
            >;
        };

        number_symbol_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            bindings = <
&none     &none      &kp GRAVE  &kp MINUS             &kp EQUAL              &kp LEFT_BRACKET    &kp RIGHT_BRACKET  &kp BACKSLASH  &kp SEMICOLON  &none      &none      &trans
&kp LGUI  &kp N1     &kp N2     &kp N3                &kp N4                 &kp N5              &kp N6             &kp N7         &kp N8         &kp N9     &kp N0     &kp RGUI
&none     &kp LCTRL  &kp LSHFT  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp COMMA           &kp PERIOD         &kp FSLH       &kp SQT        &kp RSHFT  &kp RCTRL  &none
                                &kp TAB               &kp ESC                &trans              &kp RET            &kp BACKSPACE  &kp DELETE
            >;
        };

        function_layer {
            bindings = <
&kp F13  &kp F14    &kp F15    &kp F16  &kp F17  &kp F18      &kp F19    &kp F20        &kp F21     &kp F22    &kp F23    &kp F24
&kp F1   &kp F2     &kp F3     &kp F4   &kp F5   &kp F6       &kp F7     &kp F8         &kp F9      &kp F10    &kp F11    &kp F12
&none    &kp LCTRL  &kp LSHFT  &none    &none    &none        &none      &none          &none       &kp RSHFT  &kp RCTRL  &none
                               &kp TAB  &trans   &kp SPACE    &kp ENTER  &kp BACKSPACE  &kp DELETE
            >;
        };

        system_layer {
            bindings = <
&none       &none         &none         &none         &none         &none           &none    &none   &none    &none  &none  &none
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &none    &none   &none    &none  &none  &none
&none       &none         &none         &none         &none         &none           &none    &none   &none    &none  &none  &none
                                        &kp TAB       &kp ESC       &kp SPACE       &kp RET  &trans  &kp DEL
            >;
        };

        GAME_HUB {
            bindings = <
&none  &to 6  &to 8  &none  &none  &none    &none  &none  &none  &none  &none  &to 0
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
&none  &none  &none  &none  &none  &none    &none  &none  &none  &none  &none  &none
                     &none  &none  &none    &none  &none  &none
            >;
        };

        AE_COMBAT_GAME {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp N1    &kp N2       &kp B    &kp M     &kp U    &kp J  &kp V  &to 5
&kp TAB    &kp A  &kp S  &kp D      &kp F     &kp N3       &kp C    &kp N     &kp H    &kp K  &none  &to 7
&kp LSHFT  &kp Z  &kp X  &kp C      &none     &kp N4       &none    &none     &none    &none  &none  &to 0
                         &kp LCTRL  &kp LALT  &kp SPACE    &kp RET  &kp BSPC  &kp DEL
            >;
        };

        AE_AIC_GAME {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp T     &kp F1       &kp Y    &kp BSLH  &kp Z    &kp X  &none  &to 5
&kp TAB    &kp A  &kp S  &kp D      &none     &kp F4       &none    &none     &none    &none  &none  &to 6
&kp LSHFT  &none  &none  &none      &none     &none        &none    &none     &none    &none  &none  &to 0
                         &kp LCTRL  &kp LALT  &kp SPACE    &kp RET  &kp BSPC  &kp DEL
            >;
        };

        MC_GAME {
            bindings = <
&kp ESC    &kp Q  &kp W  &kp E      &kp N1    &kp N2       &kp N7   &kp N6    &none    &none  &none  &to 5
&kp TAB    &kp A  &kp S  &kp D      &kp F     &kp N3       &kp N8   &none     &none    &none  &none  &none
&kp LSHFT  &kp Z  &kp X  &kp C      &kp N5    &kp N4       &kp N9   &kp N0    &none    &none  &none  &to 0
                         &kp LCTRL  &kp LALT  &kp SPACE    &kp RET  &kp BSPC  &kp DEL
            >;
        };
    };
};
